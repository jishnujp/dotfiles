#!/usr/bin/env python3
"""Build a ledger of every model run on this box and report it by task type.

Reads three sources that already exist on disk, so nothing new has to be
instrumented:

  1. delegate-codex jobs      ~/.local/state/delegate-codex/<job>/{state.json,events.jsonl}
  2. Codex session rollouts   ~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl
  3. Claude Code transcripts  ~/.claude/projects/<project>/<session>.jsonl
                              ~/.claude/projects/<project>/<session>/subagents/agent-*.jsonl

`build` writes one JSON row per run (a Codex session, a Claude Code session, a
Claude subagent) with model, effort, task type, wall time, a token split that
separates cache reads and writes, an estimated API cost, and for Codex the share
of the weekly subscription window the run consumed. `report` turns one or more
ledgers into a Markdown comparison grouped by task type, model and effort, written
so a person or an LLM can read it without the raw files.

Usage:
  delegation-ledger build  -o ledger-before.jsonl [--since 2026-09-15]
  delegation-ledger report ledger-before.jsonl ledger-after.jsonl -o compare.md
"""

import argparse
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone
import json
import os
from pathlib import Path
import re
import statistics
import sys


# List API prices in USD per million tokens. OpenAI charges cache writes at the
# input rate and has no 1-hour tier; Anthropic bills cache writes above input.
PRICES = {
    "claude-fable-5-1": {"in": 10, "w5m": 12.5, "w1h": 20, "read": 0.25, "out": 50},
    "claude-mythos-5-1": {"in": 10, "w5m": 12.5, "w1h": 20, "read": 0.25, "out": 50},
    "claude-fable-5": {"in": 10, "w5m": 12.5, "w1h": 20, "read": 1, "out": 50},
    "claude-opus-5-5": {"in": 4, "w5m": 5, "w1h": 8, "read": 0.20, "out": 20},
    "claude-opus-5": {"in": 5, "w5m": 6.25, "w1h": 10, "read": 0.5, "out": 25},
    "claude-opus-4-8": {"in": 5, "w5m": 6.25, "w1h": 10, "read": 0.5, "out": 25},
    "claude-opus-4-7": {"in": 5, "w5m": 6.25, "w1h": 10, "read": 0.5, "out": 25},
    "claude-opus-4-6": {"in": 5, "w5m": 6.25, "w1h": 10, "read": 0.5, "out": 25},
    "claude-sonnet-5": {"in": 2, "w5m": 2.5, "w1h": 4, "read": 0.2, "out": 10},
    "claude-sonnet-4-6": {"in": 3, "w5m": 3.75, "w1h": 6, "read": 0.3, "out": 15},
    "claude-haiku-4-5": {"in": 1, "w5m": 1.25, "w1h": 2, "read": 0.1, "out": 5},
    "gpt-6-astra": {"in": 10, "w5m": 10, "w1h": 10, "read": 1, "out": 50},
    "gpt-6-sol": {"in": 2, "w5m": 2, "w1h": 2, "read": 0.2, "out": 10},
    "gpt-6-luna": {"in": 0.1, "w5m": 0.1, "w1h": 0.1, "read": 0.01, "out": 0.5},
    "gpt-5.6-sol": {"in": 4, "w5m": 4, "w1h": 4, "read": 0.4, "out": 20},
    "gpt-5.6-terra": {"in": 2, "w5m": 2, "w1h": 2, "read": 0.2, "out": 12},
    "gpt-5.6-luna": {"in": 0.2, "w5m": 0.2, "w1h": 0.2, "read": 0.02, "out": 1.2},
}

TASK_TYPES = ("review", "exploration", "implementation", "other")
REVIEW_WORDS = re.compile(r"\b(review|audit|second opinion|critique|verify the diff|assess)\b")
EXPLORE_WORDS = re.compile(r"\b(explore|investigate|explain|trace|how does|where (is|does|are)|"
                           r"find (out|where|all)|research|summari[sz]e|read-only|read only|"
                           r"do not (modify|edit|change)|don't (modify|edit|change)|report (back|only))\b")
IMPLEMENT_WORDS = re.compile(r"\b(implement|add|build|fix|refactor|write|migrate|change|update|create|"
                             r"wire|rename|remove|delete|replace|make it|edit)\b")
BOILERPLATE = ("<recommended_plugins>", "<environment_context>", "<user_instructions>",
               "<permissions instructions>", "<turn_aborted>", "<app_context>")


def parse_ts(value):
    if not value:
        return None
    try:
        ts = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None
    return ts if ts.tzinfo else ts.replace(tzinfo=timezone.utc)


def parse_date(value):
    """YYYY-MM-DD for --since / --until; anything else is an argparse error."""
    try:
        return datetime.strptime(value, "%Y-%m-%d").replace(tzinfo=timezone.utc)
    except ValueError:
        raise argparse.ArgumentTypeError("dates are YYYY-MM-DD, got " + repr(value))


def iso(ts):
    return ts.astimezone(timezone.utc).isoformat(timespec="seconds") if ts else None


def read_jsonl(path, strict=False):
    """Dict records from a JSONL file. Malformed lines are skipped; a missing file is
    skipped for scanned logs and fatal for a ledger the user named (strict)."""
    try:
        stream = open(path, encoding="utf-8", errors="replace")
    except OSError as exc:
        if strict:
            raise SystemExit(f"cannot read {path}: {exc.strerror}")
        return
    with stream:
        for line in stream:
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(record, dict):
                yield record


def normalize_model(name):
    if not name:
        return None
    name = str(name).lower().strip()
    name = re.sub(r"\[.*?\]$", "", name).strip()          # claude-opus-5-5[1m]
    name = re.sub(r"-\d{8}$", "", name)                    # dated snapshots
    for known in sorted(PRICES, key=len, reverse=True):
        if name.startswith(known):
            return known
    return name


def mode(values):
    values = [value for value in values if value]
    return Counter(values).most_common(1)[0][0] if values else None


def first_text(content):
    """First human-readable text from a message content string or block list."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for block in content:
            if isinstance(block, dict):
                text = block.get("text") or block.get("input_text")
                if isinstance(text, str) and text.strip():
                    return text
                if block.get("type") == "tool_result":
                    return None
    return None


def prompt_head(text, limit=240):
    if not text:
        return None
    text = re.sub(r"\s+", " ", text).strip()
    return text[:limit] + ("..." if len(text) > limit else "")


def classify(prompt, sandbox=None, label=None):
    """Heuristic task type. Rows keep the prompt head so a reader can override."""
    text = " ".join(part for part in (label, prompt) if part).lower()[:800]
    text = text.replace("_", " ").replace("-", " ")
    if REVIEW_WORDS.search(text):
        return "review"
    if EXPLORE_WORDS.search(text):
        return "exploration"
    if IMPLEMENT_WORDS.search(text):
        return "implementation"
    if sandbox == "read-only":
        return "exploration"
    if sandbox in ("workspace-write", "danger-full-access"):
        return "implementation"
    return "other"


def cost_usd(model, tokens, one_hour_writes=0):
    """Unrounded list-price cost of one token split, or None for an unpriced model."""
    price = PRICES.get(model)
    if not price:
        return None
    writes = tokens["cache_write"]
    one_hour_writes = min(one_hour_writes, writes)
    return (tokens["input_uncached"] * price["in"]
            + tokens["cache_read"] * price["read"]
            + one_hour_writes * price["w1h"]
            + (writes - one_hour_writes) * price["w5m"]
            + tokens["output"] * price["out"]) / 1_000_000


def cost_by_model(by_model, one_hour_by_model=None):
    """Sum of per-model costs; None when any model that produced tokens has no price."""
    total = 0.0
    for model, tokens in by_model.items():
        cost = cost_usd(model, tokens, (one_hour_by_model or {}).get(model, 0))
        if cost is None:
            return None
        total += cost
    return round(total, 4)


def add_tokens(into, tokens):
    for key in ("input_uncached", "cache_read", "cache_write", "output", "reasoning"):
        into[key] += tokens.get(key, 0)


def empty_tokens():
    return {"input_uncached": 0, "cache_read": 0, "cache_write": 0, "output": 0, "reasoning": 0}


def add_codex_usage(tokens, usage):
    """Codex usage: input_tokens includes the cached part. Reasoning is inside output."""
    if not isinstance(usage, dict):
        return
    cached = int(usage.get("cached_input_tokens") or 0)
    write = int(usage.get("cache_write_input_tokens") or 0)
    tokens["input_uncached"] += max(0, int(usage.get("input_tokens") or 0) - cached - write)
    tokens["cache_read"] += cached
    tokens["cache_write"] += write
    tokens["output"] += int(usage.get("output_tokens") or 0)
    tokens["reasoning"] += int(usage.get("reasoning_output_tokens") or 0)


IDLE_CAP_S = 15 * 60   # a gap longer than this between events counts as idle, not work


def active_seconds(timestamps):
    """Sum of gaps between consecutive events, each capped at IDLE_CAP_S."""
    stamps = sorted(ts for ts in timestamps if ts)
    return round(sum(min((b - a).total_seconds(), IDLE_CAP_S) for a, b in zip(stamps, stamps[1:])))


def finish(row, started, ended, by_model, one_hour_by_model=None, timestamps=None):
    """Fill the derived columns. `by_model` maps normalized model -> token split."""
    tokens = empty_tokens()
    for part in by_model.values():
        add_tokens(tokens, part)
    weights = {model: part["output"] + part["input_uncached"] + part["cache_read"] for model, part in by_model.items()}
    row["model"] = row.get("model") or (max(weights, key=weights.get) if weights else None)
    row["models"] = sorted(model for model in by_model if model) if len(by_model) > 1 else None
    row["started_at"] = iso(started)
    row["ended_at"] = iso(ended)
    row["wall_s"] = round((ended - started).total_seconds()) if started and ended else None
    row["duration_s"] = active_seconds(timestamps) if timestamps else row["wall_s"]
    row["tokens"] = tokens
    row["tokens"]["total"] = (tokens["input_uncached"] + tokens["cache_read"]
                              + tokens["cache_write"] + tokens["output"])
    context = tokens["input_uncached"] + tokens["cache_read"] + tokens["cache_write"]
    row["cache_hit_ratio"] = round(tokens["cache_read"] / context, 3) if context else None
    row["est_cost_usd"] = cost_by_model(by_model, one_hour_by_model)
    row["task_type"] = classify(row.get("prompt_head"), row.get("sandbox"), row.get("label"))
    return row


# ----------------------------------------------------------------------------- sources

def load_jobs(job_root):
    """delegate-codex job states grouped by Codex thread id (a resumed thread has several),
    plus jobs that never reported a thread."""
    by_thread, orphans = defaultdict(list), []
    for state_path in sorted(Path(job_root).glob("*/state.json")):
        try:
            state = json.loads(state_path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(state, dict):
            continue
        state["_dir"] = state_path.parent
        if state.get("thread_id"):
            by_thread[state["thread_id"]].append(state)
        else:
            orphans.append([state])
    for states in by_thread.values():
        states.sort(key=lambda state: state.get("created_at") or "")
    return by_thread, orphans


def job_fields(states):
    """Job columns for one thread: label and sandbox from the first job, outcome from the last."""
    first, last = states[0], states[-1]
    return {"job_id": first.get("job_id"), "job_ids": [state.get("job_id") for state in states],
            "label": first.get("label"), "job_status": last.get("status"), "exit_code": last.get("exit_code"),
            "sandbox": first.get("sandbox"), "effort": last.get("reasoning") or first.get("reasoning"),
            "resumes": len(states) - 1}


def row_from_job_events(states):
    """Fallback when a thread's Codex session files are not on this box."""
    by_model, items, timestamps = defaultdict(empty_tokens), Counter(), []
    for state in states:
        model = normalize_model(state.get("model"))
        for event in read_jsonl(state["_dir"] / "events.jsonl"):
            kind = event.get("type")
            if kind == "turn.completed":
                add_codex_usage(by_model[model], event.get("usage"))
            elif kind == "item.completed":
                items[(event.get("item") or {}).get("type")] += 1
        timestamps += [parse_ts(state.get("started_at") or state.get("created_at")), parse_ts(state.get("finished_at"))]
    timestamps = [ts for ts in timestamps if ts]
    row = {"source": "delegate-codex", "id": states[0].get("thread_id") or states[0].get("job_id"),
           "parent_id": None, "model": None, "cwd": states[0].get("cwd"), "prompt_head": None,
           "turns": len(states),
           "tool_calls": items["command_execution"] + items["file_change"] + items["collab_tool_call"],
           "limit_meter_delta_pct": None, "plan_type": None}
    row.update(job_fields(states))
    started = min(timestamps) if timestamps else None
    ended = max(timestamps) if timestamps else None
    return finish(row, started, ended, by_model)


def codex_partial(path):
    """One rollout file. Codex paginates a session across files that share its session id."""
    events = list(read_jsonl(path))
    if not events or events[0].get("type") != "session_meta":
        return None
    meta = events[0].get("payload") or {}
    if not isinstance(meta, dict):
        return None
    part = {"session_id": meta.get("session_id") or meta.get("id"), "meta": meta, "file": str(path),
            "thread_source": meta.get("thread_source"), "by_model": defaultdict(empty_tokens), "models": [],
            "efforts": [], "sandboxes": [], "turns": 0, "tool_calls": 0, "prompt": None,
            "limits": [], "plan": None, "timestamps": [],
            "first_ts": parse_ts(meta.get("timestamp")) or parse_ts(events[0].get("timestamp"))}
    model = None
    for event in events:
        ts = parse_ts(event.get("timestamp"))
        if ts:
            part["timestamps"].append(ts)
        kind, payload = event.get("type"), event.get("payload")
        if not isinstance(payload, dict):
            continue
        if kind == "turn_context":
            model = normalize_model(payload.get("model"))
            part["models"].append(model)
            part["efforts"].append(payload.get("effort"))
            part["sandboxes"].append((payload.get("sandbox_policy") or {}).get("type"))
        elif kind == "token_usage_record":
            add_codex_usage(part["by_model"][model], payload.get("usage"))
        elif kind == "event_msg":
            sub = payload.get("type")
            if sub == "task_complete":
                part["turns"] += 1
            elif sub == "user_message" and part["prompt"] is None:
                text = payload.get("message")
                if isinstance(text, str) and not text.lstrip().startswith(BOILERPLATE):
                    part["prompt"] = text
            elif sub == "token_count":
                rate = payload.get("rate_limits") or {}
                primary = rate.get("primary") or {}
                if primary.get("used_percent") is not None:
                    part["limits"].append((ts, primary.get("used_percent"), primary.get("resets_at"),
                                           primary.get("window_minutes")))
                part["plan"] = rate.get("plan_type") or part["plan"]
        elif kind == "response_item":
            sub = payload.get("type")
            if sub in ("custom_tool_call", "function_call", "local_shell_call"):
                part["tool_calls"] += 1
            elif sub == "message" and payload.get("role") == "user" and part["prompt"] is None:
                text = first_text(payload.get("content"))
                if text and not text.lstrip().startswith(BOILERPLATE):
                    part["prompt"] = text
    return part


def spawn_info(meta):
    """Parent thread and nickname of a Codex subagent session. Codex 0.154 puts the
    thread_spawn record under `source`; older builds put it under `originator`."""
    for key in ("source", "originator"):
        value = meta.get(key)
        if isinstance(value, dict):
            spawn = ((value.get("subagent") or {}).get("thread_spawn") or {})
            if spawn.get("parent_thread_id"):
                return spawn.get("parent_thread_id"), spawn.get("agent_nickname")
    return None, None


def row_from_codex_parts(parts, jobs_by_thread):
    """Merge every rollout file of one session (main window plus Codex-internal subagent windows)."""
    parts = sorted(parts, key=lambda part: part["first_ts"] or datetime.min.replace(tzinfo=timezone.utc))
    main = next((part for part in parts if part["thread_source"] != "subagent"), parts[0])
    meta, session_id = main["meta"], main["session_id"]
    parent_id, agent_name = spawn_info(meta)
    originator = meta.get("originator") if isinstance(meta.get("originator"), str) else None
    if parent_id:
        originator = "codex_subagent"
    by_model, models, efforts, sandboxes, limits, timestamps = defaultdict(empty_tokens), [], [], [], [], []
    turns = tool_calls = 0
    prompt = plan = None
    for part in parts:
        for model, tokens in part["by_model"].items():
            add_tokens(by_model[model], tokens)
        models += part["models"]
        efforts += part["efforts"]
        sandboxes += part["sandboxes"]
        limits += part["limits"]
        timestamps += part["timestamps"]
        turns += part["turns"]
        tool_calls += part["tool_calls"]
        prompt = prompt or part["prompt"]
        plan = plan or part["plan"]
    limits.sort(key=lambda item: item[0] or datetime.min.replace(tzinfo=timezone.utc))
    delta = window = None
    if len(limits) >= 2 and limits[0][2] == limits[-1][2]:
        delta = round(limits[-1][1] - limits[0][1], 1)
    if limits:
        window = limits[-1][3]
    row = {"source": "codex", "id": session_id, "parent_id": parent_id, "originator": originator,
           "agent_name": agent_name, "model": mode(models),
           "effort": mode(efforts), "sandbox": mode(sandboxes), "cwd": meta.get("cwd"),
           "git_branch": (meta.get("git") or {}).get("branch"), "cli_version": meta.get("cli_version"),
           "prompt_head": prompt_head(prompt), "turns": turns, "tool_calls": tool_calls,
           "windows": len(parts), "subagent_windows": sum(1 for part in parts if part["thread_source"] == "subagent"),
           "limit_meter_delta_pct": delta, "limit_window_minutes": window, "plan_type": plan,
           "job_id": None, "label": None, "job_status": None, "exit_code": None,
           "file": main["file"]}
    states = jobs_by_thread.get(session_id)
    if states:
        fields = job_fields(states)
        fields["effort"] = fields["effort"] or row["effort"]
        fields["sandbox"] = fields["sandbox"] or row["sandbox"]
        row.update(fields)
        row["source"] = "delegate-codex"
    started = min(timestamps) if timestamps else main["first_ts"]
    ended = max(timestamps) if timestamps else started
    return finish(row, started, ended, by_model, timestamps=timestamps)


def row_from_claude_transcript(paths, source, session_id, parent_id=None):
    """One row from every copy of a transcript (Claude Code duplicates a session's file
    when it moves into a worktree); messages are deduplicated by their API id."""
    by_model, one_hour, models, efforts, timestamps = defaultdict(empty_tokens), defaultdict(int), [], [], []
    seen_messages, seen_users = set(), set()
    prompt = cwd = branch = version = agent_id = None
    started = ended = None
    prompts = api_calls = tool_calls = 0
    for path in paths:
        for event in read_jsonl(path):
            kind, message = event.get("type"), event.get("message")
            if not isinstance(message, dict):
                message = {}
            if kind == "user":
                key = event.get("uuid") or (event.get("timestamp"), first_text(message.get("content")))
                if key in seen_users:
                    continue
                seen_users.add(key)
            elif kind == "assistant":
                if message.get("model") == "<synthetic>":   # Claude Code's own error and notice messages
                    continue
                key = message.get("id") or event.get("requestId") or event.get("uuid")
                if key in seen_messages:              # one line per content block, usage repeated on each
                    content = message.get("content")
                    if isinstance(content, list):
                        tool_calls += sum(1 for block in content if isinstance(block, dict) and block.get("type") == "tool_use")
                    continue
                seen_messages.add(key)
            ts = parse_ts(event.get("timestamp"))
            if ts:
                timestamps.append(ts)
                started = ts if started is None or ts < started else started
                ended = ts if ended is None or ts > ended else ended
            cwd = cwd or event.get("cwd")
            branch = branch or event.get("gitBranch")
            version = version or event.get("version")
            agent_id = agent_id or event.get("agentId")
            if kind == "user":
                text = first_text(message.get("content"))
                if text:
                    prompts += 1
                    prompt = prompt or text
            elif kind == "assistant":
                content = message.get("content")
                if isinstance(content, list):
                    tool_calls += sum(1 for block in content if isinstance(block, dict) and block.get("type") == "tool_use")
                api_calls += 1
                model = normalize_model(message.get("model"))
                models.append(model)
                efforts.append(event.get("effort"))
                usage = message.get("usage") or {}
                if not isinstance(usage, dict):
                    usage = {}
                tokens = by_model[model]
                tokens["input_uncached"] += int(usage.get("input_tokens") or 0)
                tokens["cache_read"] += int(usage.get("cache_read_input_tokens") or 0)
                tokens["cache_write"] += int(usage.get("cache_creation_input_tokens") or 0)
                tokens["output"] += int(usage.get("output_tokens") or 0)
                tokens["reasoning"] += int((usage.get("output_tokens_details") or {}).get("thinking_tokens") or 0)
                one_hour[model] += int((usage.get("cache_creation") or {}).get("ephemeral_1h_input_tokens") or 0)
    if api_calls == 0:
        return None
    row = {"source": source, "id": agent_id if source == "claude-subagent" else session_id,
           "parent_id": parent_id, "model": mode(models), "effort": mode(efforts),
           "sandbox": None, "cwd": cwd, "git_branch": branch, "cli_version": version,
           "prompt_head": prompt_head(prompt), "turns": prompts, "api_calls": api_calls,
           "tool_calls": tool_calls, "limit_meter_delta_pct": None, "plan_type": None,
           "job_id": None, "label": None, "job_status": None, "exit_code": None,
           "file": str(paths[0]), "copies": len(paths)}
    return finish(row, started, ended, by_model, one_hour, timestamps=timestamps)


def build(args):
    rows = []
    jobs_by_thread, orphans = load_jobs(args.job_root)
    matched = set()
    sessions_dir = Path(args.codex_home) / "sessions"
    parts_by_session = defaultdict(list)
    for path in sorted(sessions_dir.rglob("rollout-*.jsonl")):
        part = codex_partial(path)
        if part and part["session_id"]:
            parts_by_session[part["session_id"]].append(part)
    for parts in parts_by_session.values():
        row = row_from_codex_parts(parts, jobs_by_thread)
        rows.append(row)
        if row.get("job_id"):
            matched.add(row["id"])
    for thread_id, states in jobs_by_thread.items():
        if thread_id not in matched:
            rows.append(row_from_job_events(states))
    for states in orphans:
        rows.append(row_from_job_events(states))
    # Claude Code keys transcripts by project directory; one session can appear under
    # several (worktrees), and subagent files can outlive their parent transcript.
    projects = Path(args.claude_dir) / "projects"
    mains, subs = defaultdict(list), defaultdict(list)
    for path in sorted(projects.glob("*/*.jsonl")):
        mains[path.stem].append(path)
    for path in sorted(projects.glob("*/*/subagents/agent-*.jsonl")):
        subs[(path.parents[1].name, path.stem[len("agent-"):])].append(path)
    for session_id, paths in mains.items():
        row = row_from_claude_transcript(paths, "claude-code", session_id)
        if row:
            rows.append(row)
    for (session_id, agent_id), paths in subs.items():
        row = row_from_claude_transcript(paths, "claude-subagent", session_id, parent_id=session_id)
        if row:
            rows.append(row)
    since = args.since
    until = args.until + timedelta(days=1) if args.until else None
    kept = []
    for row in rows:
        started = parse_ts(row.get("started_at"))
        if since and (started is None or started < since):
            continue
        if until and (started is None or started >= until):
            continue
        if args.min_tokens and row["tokens"]["total"] < args.min_tokens:
            continue
        row["snapshot"] = args.snapshot or Path(args.output).stem
        kept.append(row)
    kept.sort(key=lambda row: row.get("started_at") or "")
    with open(args.output, "w") as stream:
        for row in kept:
            stream.write(json.dumps(row, sort_keys=True) + "\n")
    print(f"wrote {len(kept)} rows to {args.output}", file=sys.stderr)
    return 0


# ----------------------------------------------------------------------------- query and report

def fmt_int(value):
    return f"{int(value):,}" if value is not None else ""


def fmt_num(value, digits=1):
    return f"{value:.{digits}f}" if value is not None else ""


def fmt_pct(value):
    return f"{value * 100:.0f}%" if value is not None else ""


def mean(values):
    values = [value for value in values if value is not None]
    return statistics.fmean(values) if values else None


def median(values):
    values = [value for value in values if value is not None]
    return statistics.median(values) if values else None


def load_ledgers(paths):
    rows = []
    for path in paths:
        for row in read_jsonl(path, strict=True):
            if not isinstance(row.get("tokens"), dict):
                continue
            row.setdefault("snapshot", Path(path).stem)
            rows.append(row)
    return rows


def csv_list(value):
    return [item.strip() for item in value.split(",") if item.strip()]


def add_filter_args(parser):
    parser.add_argument("--since", type=parse_date, help="runs started on or after this UTC date (YYYY-MM-DD)")
    parser.add_argument("--until", type=parse_date, help="runs started on or before this UTC date (YYYY-MM-DD)")
    parser.add_argument("--model", help="comma-separated model prefixes, e.g. gpt-6-sol,claude-opus-5-5")
    parser.add_argument("--effort", help="comma-separated effort levels")
    parser.add_argument("--task-type", help="comma-separated task types: " + ", ".join(TASK_TYPES))
    parser.add_argument("--source", help="comma-separated sources: codex, delegate-codex, claude-code, claude-subagent")
    parser.add_argument("--snapshot", help="comma-separated snapshot names")
    parser.add_argument("--label", help="substring match on the delegate-codex label or agent name")
    parser.add_argument("--min-tokens", type=int, help="keep runs with at least this many total tokens")
    parser.add_argument("--max-tokens", type=int, help="keep runs with at most this many total tokens")
    parser.add_argument("--min-minutes", type=float, help="keep runs at least this long")


def filter_rows(rows, args):
    since = getattr(args, "since", None)
    until = args.until + timedelta(days=1) if getattr(args, "until", None) else None
    models = csv_list(args.model) if getattr(args, "model", None) else None
    efforts = csv_list(args.effort) if getattr(args, "effort", None) else None
    types = csv_list(args.task_type) if getattr(args, "task_type", None) else None
    sources = csv_list(args.source) if getattr(args, "source", None) else None
    snapshots = csv_list(args.snapshot) if getattr(args, "snapshot", None) else None
    label = getattr(args, "label", None)
    kept = []
    for row in rows:
        started = parse_ts(row.get("started_at"))
        total = (row.get("tokens") or {}).get("total") or 0
        if since and (started is None or started < since):
            continue
        if until and (started is None or started >= until):
            continue
        if models and not any((row.get("model") or "").startswith(prefix) for prefix in models):
            continue
        if efforts and (row.get("effort") or "") not in efforts:
            continue
        if types and (row.get("task_type") or "other") not in types:
            continue
        if sources and row.get("source") not in sources:
            continue
        if snapshots and row.get("snapshot") not in snapshots:
            continue
        if label and label.lower() not in ((row.get("label") or "") + " " + (row.get("agent_name") or "")).lower():
            continue
        if getattr(args, "min_tokens", None) is not None and total < args.min_tokens:
            continue
        if getattr(args, "max_tokens", None) is not None and total > args.max_tokens:
            continue
        if getattr(args, "min_minutes", None) is not None and (row.get("duration_s") or 0) < args.min_minutes * 60:
            continue
        kept.append(row)
    return kept


GROUP_KEYS = ("task_type", "snapshot", "model", "effort", "source", "sandbox", "day", "week", "label")


def group_value(row, key):
    if key == "day":
        return (row.get("started_at") or "")[:10]
    if key == "week":
        started = parse_ts(row.get("started_at"))
        return started.strftime("%G-W%V") if started else ""
    if key == "task_type":
        return row.get("task_type") or "other"
    if key == "label":
        return row.get("label") or row.get("agent_name") or ""
    return row.get(key) or "?"


def summarize(group):
    """Aggregate one group of rows into the columns used by every summary table."""
    exits = [row.get("exit_code") for row in group if row.get("exit_code") is not None]
    dur = median([row.get("duration_s") for row in group])
    return {"runs": len(group),
            "ok": f"{sum(1 for code in exits if code == 0)}/{len(exits)}" if exits else "",
            "median_min": round(dur / 60, 1) if dur is not None else None,
            "mean_tokens": mean([row["tokens"]["total"] for row in group]),
            "mean_out": mean([row["tokens"]["output"] for row in group]),
            "mean_reasoning": mean([row["tokens"]["reasoning"] for row in group]),
            "cache_hit": mean([row.get("cache_hit_ratio") for row in group]),
            "mean_cost": mean([row.get("est_cost_usd") for row in group]),
            "total_cost": sum(row.get("est_cost_usd") or 0 for row in group),
            "mean_limit_pct": mean([row.get("limit_meter_delta_pct") for row in group]),
            "total_limit_pct": sum(row.get("limit_meter_delta_pct") or 0 for row in group),
            "mean_tool_calls": mean([row.get("tool_calls") for row in group]),
            "total_tokens": sum(row["tokens"]["total"] for row in group)}


def summary_table(rows, keys):
    groups = defaultdict(list)
    for row in rows:
        groups[tuple(group_value(row, key) for key in keys)].append(row)
    lines = ["| " + " | ".join(keys) + " | runs | ok | median min | mean tokens | mean out | mean reasoning | "
             "cache hit | mean cost $ | total cost $ | mean limit % | total limit % | mean tool calls |",
             "| " + " | ".join("---" for _ in keys) + " | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |"]
    for key in sorted(groups):
        s = summarize(groups[key])
        lines.append("| " + " | ".join(str(part) for part in key) + " | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} |".format(
            s["runs"], s["ok"], fmt_num(s["median_min"]), fmt_int(s["mean_tokens"]), fmt_int(s["mean_out"]),
            fmt_int(s["mean_reasoning"]), fmt_pct(s["cache_hit"]), fmt_num(s["mean_cost"], 3),
            fmt_num(s["total_cost"], 2), fmt_num(s["mean_limit_pct"]), fmt_num(s["total_limit_pct"]),
            fmt_num(s["mean_tool_calls"])))
    return lines


ROW_COLUMNS = ("started_at", "snapshot", "source", "task_type", "label", "model", "effort", "sandbox",
               "duration_min", "in_uncached", "cache_read", "cache_write", "out", "reasoning",
               "cost_usd", "limit_pct", "tool_calls", "exit_code", "id", "prompt_head")


def flat_row(row, prompt_chars):
    tokens = row["tokens"]
    label = row.get("label") or row.get("agent_name") or ""
    return {"started_at": (row.get("started_at") or "")[:16], "snapshot": row.get("snapshot"),
            "source": row.get("source"), "task_type": row.get("task_type"), "label": label,
            "model": row.get("model") or "", "effort": row.get("effort") or "", "sandbox": row.get("sandbox") or "",
            "duration_min": round(row["duration_s"] / 60, 1) if row.get("duration_s") is not None else "",
            "in_uncached": tokens["input_uncached"], "cache_read": tokens["cache_read"],
            "cache_write": tokens["cache_write"], "out": tokens["output"], "reasoning": tokens["reasoning"],
            "cost_usd": row.get("est_cost_usd") if row.get("est_cost_usd") is not None else "",
            "limit_pct": row.get("limit_meter_delta_pct") if row.get("limit_meter_delta_pct") is not None else "",
            "tool_calls": row.get("tool_calls") if row.get("tool_calls") is not None else "",
            "exit_code": row.get("exit_code") if row.get("exit_code") is not None else "",
            "id": row.get("id"), "prompt_head": (row.get("prompt_head") or "")[:prompt_chars]}


def rows_table(rows, prompt_chars):
    lines = ["| " + " | ".join(ROW_COLUMNS) + " |", "| " + " | ".join("---" for _ in ROW_COLUMNS) + " |"]
    for row in rows:
        flat = flat_row(row, prompt_chars)
        lines.append("| " + " | ".join(str(flat[col]).replace("|", "\\|").replace("\n", " ") for col in ROW_COLUMNS) + " |")
    return lines


def emit(text, output):
    if output:
        Path(output).write_text(text)
        print(f"wrote {output}", file=sys.stderr)
    else:
        sys.stdout.write(text)


def query(args):
    rows = filter_rows(load_ledgers(args.ledgers), args)
    rows.sort(key=lambda row: row.get("started_at") or "", reverse=not args.oldest_first)
    if args.limit:
        rows = rows[:args.limit]
    if args.group_by:
        keys = csv_list(args.group_by)
        bad = [key for key in keys if key not in GROUP_KEYS]
        if bad:
            print("unknown group key(s): " + ", ".join(bad) + "; choose from " + ", ".join(GROUP_KEYS), file=sys.stderr)
            return 2
        emit("\n".join(summary_table(rows, keys)) + "\n", args.output)
        return 0
    if args.format == "jsonl":
        text = "".join(json.dumps(row, sort_keys=True) + "\n" for row in rows)
    elif args.format == "csv":
        import csv
        import io
        buffer = io.StringIO()
        writer = csv.DictWriter(buffer, fieldnames=ROW_COLUMNS)
        writer.writeheader()
        for row in rows:
            writer.writerow(flat_row(row, args.prompt_chars))
        text = buffer.getvalue()
    else:
        text = "\n".join(rows_table(rows, args.prompt_chars)) + "\n"
    emit(text, args.output)
    print(f"{len(rows)} rows", file=sys.stderr)
    return 0


HOW_TO_READ = """\
## How to read this ledger

Each row is one run: a Codex session (`codex`), a Codex session launched through
delegate-codex (`delegate-codex`, carries the job label and exit code), a Claude
Code session (`claude-code`, the orchestrator) or a Claude subagent
(`claude-subagent`, spawned by a session). Token counts come from the vendors'
own usage records; nothing is estimated except cost.

- `task_type` is a keyword heuristic over the prompt, label and sandbox (review,
  exploration, implementation, other). Re-classify from `prompt_head` where it
  looks wrong; the summary is only as good as this column.
- `duration_min` is active time: the sum of gaps between consecutive events with
  any gap over 15 minutes counted as idle. `wall_s` in the JSONL is first event to
  last event, which for a Claude Code session left open can span days.
- A Codex row merges every rollout file of one session, including the internal
  subagent windows Codex spawns (`subagent_windows`), so a delegation's tokens are
  counted once, in full.
- Tokens: `in_uncached` was billed at full input price, `cache_read` at the cache
  discount, `cache_write` at the write premium (Anthropic) or input price (OpenAI),
  `out` includes reasoning. `reasoning` is the thinking share of `out`.
- `cost_usd` uses list API prices, summed per model when a run switched models; on
  a subscription it is a proxy for how much of the usage window the run consumed,
  since both vendors meter plans at roughly those rates. `limit_pct` is the
  observed change in Codex's weekly window meter between the first and last
  sample in the run's own log. It excludes usage before the first sample and
  includes any other Codex session running at the same time, so treat it as a
  reading, not an attribution; blank when the window reset mid-run or the run is
  not Codex.
- Compare within a task type and across snapshots. A row with more tokens is not
  worse if it finished a bigger task; check `exit_code`, `tool_calls` and the
  prompt before drawing a conclusion.
- To slice further, run `delegation-ledger query <ledger.jsonl> --task-type
  implementation --model gpt-6-sol,gpt-5.6-sol --group-by model,effort`.
"""


def report(args):
    rows = filter_rows(load_ledgers(args.ledgers), args)
    if not rows:
        print("no rows after filtering", file=sys.stderr)
        return 1
    snapshots = sorted({row["snapshot"] for row in rows})
    lines = ["# Delegation ledger report", "",
             f"Generated {iso(datetime.now(timezone.utc))} from {len(rows)} rows across "
             f"{len(snapshots)} snapshot(s): {', '.join(snapshots)}.", "", HOW_TO_READ,
             "## Summary by task type, snapshot, model and effort", ""]
    lines += summary_table(rows, ["task_type", "snapshot", "model", "effort"])
    lines += ["", "## Totals by snapshot and model", ""]
    lines += summary_table(rows, ["snapshot", "model"])
    lines += ["", "## Runs by day and model", ""]
    lines += summary_table(rows, ["day", "snapshot", "model"])
    ordered = sorted(rows, key=lambda row: row.get("started_at") or "", reverse=True)[:args.max_rows]
    lines += ["", f"## Runs (newest first, at most {args.max_rows})", ""]
    lines += rows_table(ordered, args.prompt_chars)
    emit("\n".join(lines) + "\n", args.output)
    return 0


# ----------------------------------------------------------------------------- cli

def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    b = sub.add_parser("build", help="scan the logs on this box and write a JSONL ledger")
    b.add_argument("-o", "--output", required=True, help="ledger file to write (JSONL)")
    b.add_argument("--snapshot", help="name stored on every row; defaults to the output file stem")
    b.add_argument("--since", type=parse_date, help="keep runs started on or after this UTC date (YYYY-MM-DD)")
    b.add_argument("--until", type=parse_date, help="keep runs started on or before this UTC date (YYYY-MM-DD)")
    b.add_argument("--min-tokens", type=int, default=0, help="drop runs below this total token count")
    b.add_argument("--job-root", default=os.environ.get("DELEGATE_JOB_ROOT") or str(Path.home() / ".local/state/delegate-codex"))
    b.add_argument("--codex-home", default=os.environ.get("CODEX_HOME") or str(Path.home() / ".codex"))
    b.add_argument("--claude-dir", default=os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude"))
    b.set_defaults(func=build)

    q = sub.add_parser("query", help="filter ledger rows by date, model, task type or size; optionally group")
    q.add_argument("ledgers", nargs="+", help="JSONL ledgers from `build`")
    add_filter_args(q)
    q.add_argument("--group-by", help="comma-separated keys from: " + ", ".join(GROUP_KEYS))
    q.add_argument("--format", choices=["jsonl", "csv", "markdown"], default="jsonl")
    q.add_argument("--limit", type=int, help="keep only the first N rows after sorting")
    q.add_argument("--oldest-first", action="store_true")
    q.add_argument("--prompt-chars", type=int, default=160)
    q.add_argument("-o", "--output", help="file to write; stdout when omitted")
    q.set_defaults(func=query)

    r = sub.add_parser("report", help="render one or more ledgers as a Markdown comparison")
    r.add_argument("ledgers", nargs="+", help="JSONL ledgers from `build`; each file is one snapshot")
    add_filter_args(r)
    r.add_argument("-o", "--output", help="Markdown file to write; stdout when omitted")
    r.add_argument("--max-rows", type=int, default=200)
    r.add_argument("--prompt-chars", type=int, default=90)
    r.set_defaults(func=report)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
